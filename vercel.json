{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && yarn install --frozen-lockfile=false && yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'Skipping root install — handled in buildCommand'",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/skyforge/:path*", "destination": "/skyforge/:path*" },
    { "source": "/jag/:path*", "destination": "/jag/:path*" },
    { "source": "/bluehaven/:path*", "destination": "/bluehaven/:path*" },
    { "source": "/((?!api/|skyforge/|jag/|bluehaven/|static/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
