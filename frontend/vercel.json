{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "CI=false NODE_OPTIONS=--max-old-space-size=4096 yarn build",
  "outputDirectory": "build",
  "installCommand": "yarn install --ignore-engines --network-timeout 600000",
  "framework": "create-react-app",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/skyforge/:path*", "destination": "/skyforge/:path*" },
    { "source": "/jag/:path*", "destination": "/jag/:path*" },
    { "source": "/bluehaven/:path*", "destination": "/bluehaven/:path*" },
    { "source": "/((?!api/|skyforge/|jag/|bluehaven/|static/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
